<!doctype html >
<html xmlns:ng="http://angularjs.org" lang="en" ng-app="pokerApp">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <link rel="icon" href="/img/hmpoker_card_icon.png">

  <meta property="og:locale" content="en_US">
  <meta property="og:type" content="website" />
  <meta property="og:title" content="Planning Poker by HumanMade Ltd" />
  <meta property="og:description" content="Distributed scrum planning poker for estimating agile projects." />
  <meta property="og:image" content="https://planningpoker.hmn.md/img/og-image.png" />
  <meta property="og:url" content="https://planningpoker.hmn.md/" />
  <meta property="article:publisher" content="https://www.facebook.com/humanmadeltd">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:creator" content="@humanmadeltd">
  <meta name="twitter:site" content="@humanmadeltd">
  <meta name="twitter:image" content="https://planningpoker.hmn.md/img/og-image.png" />

  <title>HM Planning Poker</title>
  <link rel="stylesheet" href="/juniper/styles/style-guide.css" />
  <link rel="stylesheet" href="/css/app.css">
	<link rel="stylesheet" href="/css/fireworks.css">
</head>
<body>
  <div class="container">
    <div class="body bg{{bodyState}}" ng-controller="MainCtrl">
      <div class="container">
        <header class="header">
          <h1 class="hm-logo hm-logo--small hm-logo--red">Human Made Limited</h1>
          <a href="/" title="Back to the Lobby">
            <span class="header__logo{{logoState}}"></span>
            <h1 class="header__text">Planning Poker</h1>
          </a>
          <noscript>
            <p>This site is <em>heavily</em> dependant upon JavaScript. If you don't have it enabled, you're not going to have a Good Time.</p>
          </noscript>
        </header>

        <div class="alert">
          <div class="activity notification" ng-show="activity" ng-class="{'notification--visible': activityVisible}">
            <span class="loading--white loading--active"></span>
          </div>
          <div class="socketMessage notification" ng-show="socketMessage" ng-class="{'notification--visible': socketMessageVisible}">
            <span class="notification__icon">&#9888;</span>
            <span ng-bind="socketMessage"></span>
          </div>
          <div
            ng-repeat="toast in toasts track by toast.id"
            class="notification"
            ng-class="{'notification--visible': toast.visible, 'notification--dismissing': toast.dismissing, 'appError': toast.type === 'error'}"
          >
            <span class="notification__icon" ng-if="toast.type === 'error'">&#9888;</span>
            <span class="notification__icon" ng-if="toast.type !== 'error'">&#9432;</span>
            <span>{{toast.message}}</span>
            <button class="notification__dismiss" ng-click="dismissToast(toast)">&times;</button>
          </div>
        </div>

        <div class="content" ng-view></div>

        <div class="footer">
          <p><span class="hm-logo hm-logo--tiny"></span><a href="https://hmn.md">Made by Humans</a>, forked from <a href="https://hatjitsu.herokuapp.com/">Hatjitsu</a>, <a href="https://github.com/humanmade/Hatjitsu" target="_blank">view source</a>, <a href="https://github.com/humanmade/Hatjitsu/issues" target="_blank">having issues?</a>.</p>
        </div>
      </div>
			<div class="fireworks">
				<div class="before"></div>
				<div class="after"></div>
			</div>
    </div>
  </div>

  <script src="/socket.io/socket.io.js"></script>
  <script src="/lib/angular/angular.min.js"></script>
  <script src="/lib/angular-route/angular-route.min.js"></script>
  <script src="/lib/underscore/underscore-umd-min.js"></script>
  <script src="/js/cookies.js"></script>
  <script src="/js/decks.js"></script>
  <script src="/js/vote-math.js"></script>
  <script src="/js/socket-client.js"></script>
  <script src="/js/controllers.js"></script>
  <script src="/js/app.js"></script>
  <script src="/js/directives.js"></script>
  <script src="/js/filters.js"></script>
  <script src="/js/services.js"></script>
  <script src="/juniper/js/juniper.min.js"></script>

</body>

</html>
